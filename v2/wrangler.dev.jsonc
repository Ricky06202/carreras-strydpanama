{
  "name": "v2-dev",
  "compatibility_date": "2026-10-07",
  "d1_databases": [
    { "binding": "DB", "database_name": "carreras-v2-db", "database_id": "2ed5a4d6-d368-4e50-8dbb-36fb7514d36f", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "carreras-v2-media" }
  ],
  "vars": {
    "YAPPY_MERCHANT_ID": "REEMPLAZAR_DEV",
    "YAPPY_SECRET_KEY": "REEMPLAZAR_DEV",
    "YAPPY_URL_DOMAIN": "REEMPLAZAR_DEV"
  }
}
