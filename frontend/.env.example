# Frontend Environment Variables
# URL del backend SonicJS
SONICJS_API_URL=http://localhost:8787

# Para producción, usar la URL desplegada:
# SONICJS_API_URL=https://carreras-strydpanama-backend.your-subdomain.workers.dev

# Clave compartida para el dispositivo bibcam (rutas /api/admin/race-bibs y
# /api/admin/register-finish-camera). Si no se define, esas rutas corren en modo dev.
# Generar una larga y aleatoria. En producción va en Cloudflare Pages -> Env Vars.
# TIMING_API_KEY=
