<script define:vars={{ clientData, selectedRaceId, raceName }}>
  const data = JSON.parse(clientData);
  const all = data.finishers;
  const teams = data.teamData;
  const raffleWinnersCache = data.raffleWinners || [];
  const medals = ['🥇', '🥈', '🥉'];

  function computeRankings(list) {
    const groups = {};
    list.sort((a, b) => a.finishTime - b.finishTime);
    list.forEach((x, i) => { x.pos = i + 1; });
    list.forEach(x => {
      const key = `${x.distanceName}|||${x.categoryName}`;
      if (!groups[key]) groups[key] = [];
      groups[key].push(x);
      x.catPos = groups[key].length;
    });
    list.forEach(x => {
      const key = `${x.distanceName}|||${x.categoryName}`;
      x.totalCat = groups[key].length;
    });
  }

  computeRankings(all);


  const R2_BASE = 'https://pub-ddaf4243012a44c5a61699bc0719121f.r2.dev';
  function ensureAbsolute(url) {
    if (!url) return '';
    if (url.startsWith('data:')) return url;
    if (url.includes('pub-ddaf4243012a44c5a61699bc0719121f.r2.dev')) return url;
    if (url.includes('/uploads/')) {
      const parts = url.split('/uploads/');
      return `${R2_BASE}/uploads/${parts[parts.length - 1]}`;
    }
    if (url.startsWith('/')) return `${R2_BASE}${url}`;
    if (!url.startsWith('http')) return `${R2_BASE}/${url}`;
    return url;
  }

  // World Records for 5K road: Men (12:49), Women (14:13)
  const WR_M_TIME = 769; // 12:49
  const WR_F_TIME = 853; // 14:13

  function calculatePace(timeInSecs, distanceInKm) {
    if (!timeInSecs || !distanceInKm || distanceInKm <= 0) return null;
    return timeInSecs / distanceInKm;
  }

  function formatPace(paceSecs) {
    if (paceSecs === null || paceSecs === undefined || isNaN(paceSecs)) return '—';
    const mins = Math.floor(paceSecs / 60);
    const secs = Math.floor(paceSecs % 60);
    return `${mins}:${secs.toString().padStart(2, '0')} min/km`;
  }

  function formatPaceDiffBadge(runnerPace, targetPace) {
    if (!runnerPace || !targetPace) return `<span class="comparison-badge diff-equal">—</span>`;
    const diff = runnerPace - targetPace;
    const absDiff = Math.abs(diff);
    const mins = Math.floor(absDiff / 60);
    const secs = Math.floor(absDiff % 60);
    
    let sign = '';
    let cls = 'diff-equal';
    let label = 'igual';
    
    if (diff > 0) {
      sign = '+';
      cls = 'diff-slower';
      label = 'más lento';
    } else if (diff < 0) {
      sign = '-';
      cls = 'diff-faster';
      label = 'más rápido';
    }
    
    if (Math.abs(diff) < 0.5) {
      return `<span class="comparison-badge diff-equal">Igual</span>`;
    }
    
    return `<span class="comparison-badge ${cls}">${sign}${mins}:${secs.toString().padStart(2, '0')} ${label}</span>`;
  }

  let fDist = 'all', fCat = 'all', fGender = 'all', fSearch = '';

  function fmt(secs) {
    const s = Number(secs); const h = Math.floor(s/3600);
    const m = Math.floor((s%3600)/60); const sec = Math.floor(s%60);
    if (h > 0) return h+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');
    return String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');
  }

  function getFiltered() {
    let r = [...all];
    if (fDist !== 'all') r = r.filter(x => x.distanceName === fDist);
    if (fCat !== 'all') r = r.filter(x => x.categoryName === fCat);
    if (fGender !== 'all') r = r.filter(x => x.gender === fGender);
    if (fSearch) {
      const q = fSearch.toLowerCase();
      r = r.filter(x => x.name.toLowerCase().includes(q) || String(x.bib).includes(q) || (x.teamName||'').toLowerCase().includes(q));
    }
    r.sort((a,b) => a.finishTime - b.finishTime);
    r.forEach((x,i) => { x.fPos = i+1; });
    return r;
  }

  function renderPodium() {
    const maleList = document.getElementById('podium-male');
    const femaleList = document.getElementById('podium-female');
    if (!maleList || !femaleList) return;

    const males = all.filter(x => x.gender === 'masculino').slice(0, 3);
    const females = all.filter(x => x.gender === 'femenino').slice(0, 3);

    [{ el: maleList, data: males }, { el: femaleList, data: females }].forEach(({ el, data: list }) => {
      if (list.length === 0) { el.innerHTML = '<div style="text-align:center;color:#555;padding:20px;">Sin resultados</div>'; return; }
      el.innerHTML = list.map((r, i) => {
        const photo = r.photoUrl
          ? `<img src="${ensureAbsolute(r.photoUrl)}" alt="" class="podium-photo" />`
          : `<div class="podium-photo-placeholder">🏃</div>`;
        return `<div onclick="openRunnerModal('${r.id}')" class="podium-item p${i+1}" style="cursor: pointer;">
          <span class="podium-medal">${medals[i]}</span>
          ${photo}
          <div class="podium-info">
            <div class="podium-name">${r.name}</div>
            <div class="podium-bib">#${r.bib}</div>
          </div>
          <div class="podium-time">${fmt(r.finishTime)}</div>
        </div>`;
      }).join('');
    });
  }

  function renderTable(filtered) {
    const tbody = document.getElementById('results-body');
    const countEl = document.getElementById('result-count');
    if (!tbody) return;
    countEl.textContent = filtered.length + ' resultado' + (filtered.length !== 1 ? 's' : '');

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:40px;color:#555;">Sin resultados para los filtros seleccionados</td></tr>';
      return;
    }

    const showCheckpoints = all.some(r => r.checkpointTime);
    const thRetorno = document.getElementById('th-retorno');
    if (thRetorno) {
      thRetorno.style.display = showCheckpoints ? '' : 'none';
    }

    tbody.innerHTML = filtered.map(r => {
      const pc = r.fPos <= 3 ? `pos-${r.fPos}` : 'pos-n';
      const trCls = r.fPos === 1 ? 'tr-top1' : r.fPos === 2 ? 'tr-top2' : r.fPos === 3 ? 'tr-top3' : '';
      const cpCell = showCheckpoints
        ? `<td class="td-time" style="color:#aaa;font-size:12px;">${r.checkpointTime ? fmt(r.checkpointTime) : '—'}</td>`
        : '';
      const ph = r.photoUrl ? `<img src="${ensureAbsolute(r.photoUrl)}" alt="" class="mini-photo"/>` : '';
      
      const medalOrRank = r.catPos <= 3 ? medals[r.catPos - 1] : `#${r.catPos}`;

      return `<tr class="${trCls}" onclick="openRunnerModal('${r.id}')">
        <td><span class="pos-badge ${pc}">${r.fPos}</span></td>
        <td style="font-weight:800; color:var(--accent); font-size:12px; white-space:nowrap;">${medalOrRank} <span style="font-size:10px; font-weight:normal; color:#888;">de ${r.totalCat}</span></td>
        <td style="font-weight:700;">${ph}${r.name}</td>
        <td class="td-bib">#${r.bib}</td>
        <td style="color:#888;font-weight:600;">${r.age !== null && r.age !== undefined ? r.age + ' años' : '—'}</td>
        <td class="td-time">${fmt(r.finishTime)}</td>
        ${cpCell}
        <td><span class="td-cat">${r.categoryName}</span></td>
        <td style="color:#888;font-size:12px;">${r.distanceName}</td>
        <td style="color:#888;font-size:12px;">${r.teamName || '—'}</td>
      </tr>`;
    }).join('');
  }

  function renderCards(filtered) {
    const list = document.getElementById('card-list');
    if (!list) return;
    if (filtered.length === 0) { list.innerHTML = ''; return; }
    list.innerHTML = filtered.map(r => {
      const rcCls = r.fPos === 1 ? 'rc-top1' : r.fPos === 2 ? 'rc-top2' : r.fPos === 3 ? 'rc-top3' : '';
      return `<div onclick="openRunnerModal('${r.id}')" class="result-card ${rcCls}" style="cursor: pointer;">
        <div class="rc-pos">${r.fPos <= 3 ? medals[r.fPos-1] : r.fPos}</div>
        <div class="rc-info">
          <div class="rc-name">${r.name}</div>
          <div class="rc-meta">${r.age ? r.age + ' años · ' : ''}#${r.catPos} en ${r.categoryName} (${r.totalCat}) · ${r.distanceName}</div>
          <div class="rc-bib">#${r.bib}${r.checkpointTime ? ` · 🔁 ${fmt(r.checkpointTime)}` : ''}</div>
        </div>
        <div class="rc-time">${fmt(r.finishTime)}</div>
      </div>`;
    }).join('');
  }

  function renderTeams() {
    const container = document.getElementById('teams-container');
    if (!container) return;
    if (teams.length === 0) {
      container.innerHTML = '<div style="text-align:center;color:#555;padding:60px;">No hay equipos registrados con tiempos.</div>';
      return;
    }
    // Separar completos e incompletos
    const completeTeams = teams.filter(t => t.complete);
    const incompleteTeams = teams.filter(t => !t.complete);
    const ranked = [...completeTeams, ...incompleteTeams];

    container.innerHTML = `<div class="teams-grid">${ranked.map((t) => {
      const isComplete = t.complete;
      const rank = isComplete ? completeTeams.indexOf(t) : -1;
      const cls = rank === 0 ? 'gold' : rank === 1 ? 'silver' : rank === 2 ? 'bronze' : '';
      const medal = isComplete && rank < 3 ? medals[rank] : isComplete ? `#${rank+1}` : '⏳';
      return `<div class="team-card ${cls}" style="${!isComplete ? 'opacity:0.55;' : ''}">
        <div class="team-rank">${medal}</div>
        <div class="team-name">${t.name}</div>
        <div class="team-total-label">
          ${isComplete
            ? `Tiempo total (suma): <span class="team-total-time">${fmt(t.totalTime)}</span>`
            : `En progreso: ${t.totalMembers}/4 en meta`}
        </div>
        <hr class="team-divider"/>
        <div class="team-members-label">Integrantes</div>
        <div class="team-members">
          ${t.members.sort((a,b) => a.finishTime - b.finishTime).map(m => `
            <div onclick="openRunnerModal('${m.id}')" class="team-member" style="cursor:pointer;">
              ${m.photoUrl ? `<img src="${ensureAbsolute(m.photoUrl)}" alt="" class="mini-photo"/>` : ''}
              <span class="member-name">${m.name}</span>
              <span class="member-bib">#${m.bib}</span>
              <span class="member-sep">—</span>
              <span class="member-time">${fmt(m.finishTime)}</span>
            </div>
          `).join('')}
        </div>
      </div>`;
    }).join('')}</div>`;
  }

  function renderTombola() {
    const container = document.getElementById('tombola-container');
    const tabBtn = document.getElementById('tab-btn-tombola');
    if (!container) return;

    if (raffleWinnersCache.length === 0) {
      if (tabBtn) tabBtn.classList.add('hidden');
      container.innerHTML = '<div style="text-align:center;color:#555;padding:60px;">Aún no se han sorteado premios en esta carrera.</div>';
      return;
    }

    if (tabBtn) tabBtn.classList.remove('hidden');

    container.innerHTML = raffleWinnersCache.map(w => {
      const genderLabel = (w.gender === 'm' || w.gender === 'masculino' || w.gender === 'M' || w.gender === 'Masculino') ? 'Hombre' : (w.gender === 'f' || w.gender === 'femenino' || w.gender === 'F' || w.gender === 'Femenino') ? 'Mujer' : w.gender;
      
      const photoHtml = w.prizePhotoUrl
        ? `<img src="${ensureAbsolute(w.prizePhotoUrl)}" alt="Foto del Premio" class="tombola-photo" />`
        : `<div class="tombola-placeholder">
             <div class="tombola-placeholder-gift">🎁</div>
             <div class="tombola-placeholder-text">Foto próximamente</div>
           </div>`;

      return `
        <div class="tombola-card">
          <div class="tombola-img-container">
            ${photoHtml}
            <div class="tombola-badge">Dorsal #${w.bibNumber}</div>
          </div>
          <div class="tombola-info">
            <div class="tombola-winner-name">${w.name}</div>
            <div class="tombola-winner-meta">
              ${genderLabel}${w.categoryName ? ` · ${w.categoryName}` : ''}
            </div>
            <div class="tombola-prize-section">
              <div class="tombola-prize-label">Premio Ganado</div>
              <div class="tombola-prize-name">${w.prizeName || 'Premio Sorpresa'}</div>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function render() {
    const filtered = getFiltered();
    renderTable(filtered);
    renderCards(filtered);
  }

  // Tab switching
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('tab-' + tab.dataset.tab)?.classList.add('active');
    });
  });

  // Filter chips
  function setupChips(containerId, setter) {
    document.querySelectorAll(`#${containerId} .chip`).forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll(`#${containerId} .chip`).forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        setter(btn.dataset.val);
        render();
      });
    });
  }
  setupChips('dist-chips', v => fDist = v);
  setupChips('cat-chips', v => fCat = v);
  setupChips('gender-chips', v => fGender = v);

  const si = document.getElementById('search-input');
  if (si) si.addEventListener('input', e => { fSearch = e.target.value; render(); });

  // Polling logic for real-time updates
  async function pollResults() {
    if (!selectedRaceId) return;
    try {
      const res = await fetch(`/api/results-data?raceId=${selectedRaceId}&_t=${Date.now()}`, {
        headers: {
          'Cache-Control': 'no-cache, no-store, must-revalidate',
          'Pragma': 'no-cache'
        }
      });
      if (!res.ok) return;
      const json = await res.json();
      if (json.success) {
        // Update client data
        all.length = 0;
        all.push(...json.finishers);
        computeRankings(all);
        
        teams.length = 0;
        teams.push(...json.teamData);

        // Update raffle winners
        raffleWinnersCache.length = 0;
        if (json.raffleWinners && Array.isArray(json.raffleWinners)) {
          raffleWinnersCache.push(...json.raffleWinners);
        }

        if (all.length > 0 || raffleWinnersCache.length > 0) {
          const emptyState = document.getElementById('empty-state');
          const resultsApp = document.getElementById('results-app');
          const statsContainer = document.getElementById('stats-container');
          const premiacionBtnWrap = document.getElementById('premiacion-btn-wrap');
          
          if (emptyState) emptyState.classList.add('hidden');
          if (resultsApp) resultsApp.classList.remove('hidden');
          
          if (statsContainer) {
            if (all.length > 0) statsContainer.classList.remove('hidden');
            else statsContainer.classList.add('hidden');
          }
          if (premiacionBtnWrap) {
            if (all.length > 0) premiacionBtnWrap.classList.remove('hidden');
            else premiacionBtnWrap.classList.add('hidden');
          }

          // Update stats in the DOM
          const countVal = document.getElementById('stat-finishers');
          if (countVal) countVal.textContent = all.length;

          const malesList = all.filter(x => x.gender === 'masculino');
          const fastestM = malesList[0];
          const mVal = document.getElementById('stat-fastest-m');
          if (mVal) mVal.textContent = fastestM ? fmt(fastestM.finishTime) : '—';

          const femalesList = all.filter(x => x.gender === 'femenino');
          const fastestF = femalesList[0];
          const fVal = document.getElementById('stat-fastest-f');
          if (fVal) fVal.textContent = fastestF ? fmt(fastestF.finishTime) : '—';

          const avgTime = Math.round(all.reduce((s,f) => s + f.finishTime, 0) / all.length);
          const avgVal = document.getElementById('stat-avg-time');
          if (avgVal) avgVal.textContent = fmt(avgTime);

          const mPct = Math.round(malesList.length / all.length * 100);
          const fPct = 100 - mPct;

          const barM = document.getElementById('gender-bar-m');
          if (barM) barM.style.width = `${mPct}%`;

          const legendM = document.getElementById('gender-legend-m-pct');
          if (legendM) legendM.textContent = `Masculino ${mPct}%`;

          const legendF = document.getElementById('gender-legend-f-pct');
          if (legendF) legendF.textContent = `Femenino ${fPct}%`;

          const splitCount = document.getElementById('gender-split-count');
          if (splitCount) splitCount.textContent = `${malesList.length}M · ${femalesList.length}F`;

          // Actualizar barra de progreso de carrera
          const totalRunners = json.totalRunners || 0;
          const totalFinished = json.totalFinished || 0;
          const totalMissing = json.totalMissing || 0;
          const progressPct = json.progressPct !== undefined ? json.progressPct : 0;

          const progressFill = document.getElementById('progress-bar-fill');
          if (progressFill) progressFill.style.width = `${progressPct}%`;

          const progressFinished = document.getElementById('progress-legend-finished');
          if (progressFinished) progressFinished.textContent = `En Meta: ${totalFinished} (${progressPct}%)`;

          const progressMissing = document.getElementById('progress-legend-missing');
          if (progressMissing) progressMissing.textContent = `Faltan por llegar: ${totalMissing} (${100 - progressPct}%)`;

          const progressSplit = document.getElementById('progress-split-count');
          if (progressSplit) progressSplit.textContent = `${totalFinished} / ${totalRunners} Corredores`;
        }

        renderPodium();
        render();
        renderTeams();
        renderTombola();
      }
    } catch (e) {
      console.error('Error polling results:', e);
    }
  }

  window.openRunnerModal = function(runnerId) {
    const r = all.find(x => x.id === runnerId);
    if (!r) return;

    // General rank: all is sorted by finishTime, so r.pos is their general rank
    const generalPos = r.pos;
    const totalGeneral = all.length;

    // Distance ranking
    const distFinishers = all.filter(x => x.distanceName === r.distanceName);
    const distPos = distFinishers.findIndex(x => x.id === r.id) + 1;
    const totalDist = distFinishers.length;

    // Category ranking
    const catPos = r.catPos;
    const totalCat = r.totalCat;

    const imgEl = document.getElementById('modal-runner-img');
    const placeholderEl = document.getElementById('modal-runner-placeholder');

    if (r.photoUrl) {
      imgEl.src = ensureAbsolute(r.photoUrl);
      imgEl.classList.remove('hidden');
      placeholderEl.classList.add('hidden');
    } else {
      imgEl.classList.add('hidden');
      placeholderEl.classList.remove('hidden');
    }

    document.getElementById('modal-runner-name').textContent = r.name;
    document.getElementById('modal-runner-bib').textContent = `#${r.bib}`;
    document.getElementById('modal-runner-race').textContent = raceName;
    document.getElementById('modal-runner-team').textContent = r.teamName ? `👥 Equipo: ${r.teamName}` : 'Individual';
    
    document.getElementById('modal-runner-time').textContent = fmt(r.finishTime);

    const cpContainer = document.getElementById('modal-runner-checkpoint-container');
    if (r.checkpointTime) {
      document.getElementById('modal-runner-checkpoint').textContent = fmt(r.checkpointTime);
      cpContainer.classList.remove('hidden');
    } else {
      cpContainer.classList.add('hidden');
    }

    document.getElementById('modal-rank-cat').textContent = `#${catPos || '—'}`;
    document.getElementById('modal-rank-cat-total').textContent = `de ${totalCat || 0}`;

    document.getElementById('modal-rank-dist').textContent = `#${distPos || '—'}`;
    document.getElementById('modal-rank-dist-total').textContent = `de ${totalDist || 0}`;

    document.getElementById('modal-rank-general').textContent = `#${generalPos || '—'}`;
    document.getElementById('modal-rank-general-total').textContent = `de ${totalGeneral || 0}`;

    document.getElementById('modal-runner-cat-val').textContent = r.categoryName || 'General';
    document.getElementById('modal-runner-age-val').textContent = r.age ? `${r.age} años` : '—';
    document.getElementById('modal-runner-dist-val').textContent = r.distanceName || 'General';

    // Parse distance dynamically
    let distance = 5.0;
    const distStr = (r.distanceName || '').toLowerCase();
    const parsedDist = parseFloat(distStr);
    if (!isNaN(parsedDist) && parsedDist > 0) {
      distance = parsedDist;
    }
    const cpDist = distance / 2;

    // Calculate paces
    const paceTotal = calculatePace(r.finishTime, distance);
    const paceIda = r.checkpointTime ? calculatePace(r.checkpointTime, cpDist) : null;
    const paceRegreso = r.checkpointTime ? calculatePace(r.finishTime - r.checkpointTime, distance - cpDist) : null;

    // Splits table HTML
    const splitsBody = document.getElementById('modal-splits-body');
    if (splitsBody) {
      splitsBody.innerHTML = `
        <tr style="border-bottom: 1px solid #2d2d2d;">
          <td style="padding: 10px 14px; color: #fff;">Ida</td>
          <td style="padding: 10px 14px; color: #888;">${cpDist.toFixed(1)} km</td>
          <td style="padding: 10px 14px; color: #888;">${r.checkpointTime ? fmt(r.checkpointTime) : '—'}</td>
          <td style="padding: 10px 14px; text-align: right; font-family: ui-monospace, monospace; font-weight: 700; color: #fff;">
            ${formatPace(paceIda)}
          </td>
        </tr>
        <tr style="border-bottom: 1px solid #2d2d2d;">
          <td style="padding: 10px 14px; color: #fff;">Regreso</td>
          <td style="padding: 10px 14px; color: #888;">${(distance - cpDist).toFixed(1)} km</td>
          <td style="padding: 10px 14px; color: #888;">${r.checkpointTime ? fmt(r.finishTime - r.checkpointTime) : '—'}</td>
          <td style="padding: 10px 14px; text-align: right; font-family: ui-monospace, monospace; font-weight: 700; color: #fff;">
            ${formatPace(paceRegreso)}
          </td>
        </tr>
        <tr style="background: rgba(255, 107, 0, 0.06);">
          <td style="padding: 10px 14px; font-weight: 700; color: #FF6B00;">Total</td>
          <td style="padding: 10px 14px; font-weight: 700; color: #FF6B00;">${distance.toFixed(1)} km</td>
          <td style="padding: 10px 14px; font-weight: 700; color: #FF6B00;">${fmt(r.finishTime)}</td>
          <td style="padding: 10px 14px; text-align: right; font-family: ui-monospace, monospace; font-weight: 800; color: #FF6B00;">
            ${formatPace(paceTotal)}
          </td>
        </tr>
      `;
    }

    // Find winners for comparisons
    // Note: overallWinner is the first one in "all" with same gender and same distance
    const overallWinner = all.find(x => x.gender === r.gender && x.distanceName === r.distanceName);
    const overallWinnerPace = overallWinner ? calculatePace(overallWinner.finishTime, distance) : null;

    // categoryWinner is the first one in "all" with same category, gender, and distance
    const categoryWinner = all.find(x => x.categoryName === r.categoryName && x.gender === r.gender && x.distanceName === r.distanceName);
    const categoryWinnerPace = categoryWinner ? calculatePace(categoryWinner.finishTime, distance) : null;

    // World Record comparison (for 5K)
    const isMale = (r.gender || '').toLowerCase() === 'masculino' || (r.gender || '').toLowerCase() === 'm';
    const wrTime = isMale ? WR_M_TIME : WR_F_TIME;
    const wrLabel = isMale ? 'Récord Mundial 5K Calle (M)' : 'Récord Mundial 5K Calle (F)';
    const wrPace = wrTime / 5;

    const compsCard = document.getElementById('modal-comparisons-card');
    if (compsCard) {
      let compsHtml = '';

      // 1. Ganador General (Mismo sexo)
      if (overallWinner) {
        const isSelf = overallWinner.id === r.id;
        const winnerPaceStr = formatPace(overallWinnerPace);
        const nameDisplay = isSelf ? 'Tú (Ganador General)' : overallWinner.name;
        compsHtml += `
          <div class="comparison-row">
            <div class="comparison-info">
              <span class="comparison-label">Ganador General (${r.gender === 'masculino' ? 'Masc' : 'Fem'})</span>
              <span class="comparison-sub">${nameDisplay} · Ritmo: ${winnerPaceStr}</span>
            </div>
            ${isSelf ? '<span class="comparison-badge diff-equal">Ganador</span>' : formatPaceDiffBadge(paceTotal, overallWinnerPace)}
          </div>
        `;
      }

      // 2. Ganador Categoría (Mismo sexo)
      if (categoryWinner) {
        const isSelf = categoryWinner.id === r.id;
        const catWinnerPaceStr = formatPace(categoryWinnerPace);
        const nameDisplay = isSelf ? 'Tú (Ganador Categoría)' : categoryWinner.name;
        compsHtml += `
          <div class="comparison-row">
            <div class="comparison-info">
              <span class="comparison-label">Ganador Categoría (${r.categoryName})</span>
              <span class="comparison-sub">${nameDisplay} · Ritmo: ${catWinnerPaceStr}</span>
            </div>
            ${isSelf ? '<span class="comparison-badge diff-equal">Ganador</span>' : formatPaceDiffBadge(paceTotal, categoryWinnerPace)}
          </div>
        `;
      }

      // 3. Récord Mundial
      const wrPaceStr = formatPace(wrPace);
      compsHtml += `
        <div class="comparison-row">
          <div class="comparison-info">
            <span class="comparison-label">${wrLabel} (${isMale ? '12:49' : '14:13'})</span>
            <span class="comparison-sub">Referencia élite · Ritmo: ${wrPaceStr}</span>
          </div>
          ${formatPaceDiffBadge(paceTotal, wrPace)}
        </div>
      `;

      compsCard.innerHTML = compsHtml;
    }

    const certBtn = document.getElementById('modal-cert-btn');
    if (certBtn) {
      certBtn.href = `/corredor/${r.id}`;
    }

    const modal = document.getElementById('runner-modal');
    if (modal) {
      modal.classList.remove('hidden');
    }
    document.body.style.overflow = 'hidden';
  }

  window.closeRunnerModal = function() {
    const modal = document.getElementById('runner-modal');
    if (modal) {
      modal.classList.add('hidden');
    }
    document.body.style.overflow = '';
  }

  // Initial render
  renderPodium();
  render();
  renderTeams();
  renderTombola();

  // Start polling every 5 seconds
  setInterval(pollResults, 5000);
</script>
</Layout>
