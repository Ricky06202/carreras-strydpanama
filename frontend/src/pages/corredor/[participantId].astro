---
import { env } from 'cloudflare:workers';
import { apiFetch } from '../../lib/api';

const { participantId } = Astro.params;

let participant: any = null;
let race: any = null;
let positionGeneral: number | null = null;
let positionGender: number | null = null;
let positionCategory: number | null = null;
let totalInDistance: number = 0;
let error = '';

try {
  const partRes = await apiFetch(`/api/content/${participantId}`, env, { method: 'GET' });
  participant = partRes?.data;

  if (!participant) throw new Error('Participante no encontrado');

  const raceId = participant.data?.race;
  if (raceId) {
    const raceRes = await apiFetch(`/api/content/${raceId}`, env, { method: 'GET' });
    race = raceRes?.data;

    const allPartsRes = await apiFetch(`/api/collections/participants/content?limit=2000`, env, { method: 'GET' });
    const raceParts = (allPartsRes?.data || []).filter((p: any) =>
      (p.data?.race === raceId || p.data?.raceId === raceId) && 
      p.data?.finishTime && 
      p.data?.registrationType !== 'team'
    );

    // Posiciones y clasificaciones dentro de la misma distancia
    const myDistance = participant.data?.distance;
    if (myDistance) {
      const inDist = raceParts.filter((p: any) => p.data?.distance === myDistance)
        .sort((a: any, b: any) => Number(a.data.finishTime) - Number(b.data.finishTime));
      totalInDistance = inDist.length;

      // 1. Posición General (dentro de la distancia)
      const distIdx = inDist.findIndex((p: any) => p.id === participantId);
      if (distIdx !== -1) positionGeneral = distIdx + 1;

      // 2. Posición Rama (dentro de la distancia y mismo género)
      const myGender = participant.data?.gender || '';
      if (myGender) {
        const inGender = inDist.filter((p: any) => (p.data?.gender || '').toLowerCase() === myGender.toLowerCase());
        const genderIdx = inGender.findIndex((p: any) => p.id === participantId);
        if (genderIdx !== -1) positionGender = genderIdx + 1;
      }

      // 3. Posición Categoría (dentro de la distancia y misma categoría)
      const myCategory = participant.data?.category;
      if (myCategory) {
        const inCat = inDist.filter((p: any) => p.data?.category === myCategory);
        const catIdx = inCat.findIndex((p: any) => p.id === participantId);
        if (catIdx !== -1) positionCategory = catIdx + 1;
      }
    }
  }
} catch (e: any) {
  error = e.message;
}

function formatTime(secs: number | string): string {
  const s = Number(secs);
  if (isNaN(s)) return '--:--';
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = s % 60;
  if (h > 0) return `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
  return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
}

const name = participant ? `${participant.data?.firstName || ''} ${participant.data?.lastName || ''}`.trim() : 'Corredor';
const raceName = race?.data?.title || 'Carrera';
const categoryName = participant?.data?.categoryName || '';
const teamName = participant?.data?.teamName || '';
const rawDistanceName = participant?.data?.distanceName || '';
let distanceName = rawDistanceName;
if (rawDistanceName.toLowerCase().includes('1k') || rawDistanceName.toLowerCase().includes('1 k')) {
  distanceName = '1k';
} else if (rawDistanceName.toLowerCase().includes('5k') || rawDistanceName.toLowerCase().includes('5 k')) {
  distanceName = '5k';
}

const birthDateStr = participant?.data?.birthDate || '';
const raceDateStr = race?.data?.date || '';
let age: number | null = null;
if (birthDateStr) {
  const birthYear = new Date(birthDateStr).getFullYear();
  const raceYear = raceDateStr ? new Date(raceDateStr).getFullYear() : new Date().getFullYear();
  if (!isNaN(birthYear)) age = raceYear - birthYear;
}


const R2_BASE_URL = 'https://pub-ddaf4243012a44c5a61699bc0719121f.r2.dev';
const rawPhotoUrl = participant?.data?.photoUrl || '';
let fixedImageUrl = rawPhotoUrl ? rawPhotoUrl.replace("https://api.carreras.strydpanama.com", R2_BASE_URL) : '';
if (fixedImageUrl && !fixedImageUrl.startsWith('http')) {
  fixedImageUrl = `${R2_BASE_URL}${fixedImageUrl.startsWith('/') ? '' : '/'}${fixedImageUrl}`;
}

const ensureAbsolute = (url: string) => {
  if (!url) return '';
  if (url.startsWith('http') || url.startsWith('data:')) return url;
  return `${R2_BASE_URL}${url.startsWith('/') ? '' : '/'}${url}`;
};

const certLogoUrl = ensureAbsolute(race?.data?.certificateLogoUrl || '');

const finishTime = participant?.data?.finishTime;
const bibNumber = participant?.data?.bibNumber;
const raceDate = race?.data?.date ? new Date(race.data.date).toLocaleDateString('es-PA', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const hasResult = !!finishTime;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{name} — Resultados STRYD Panama</title>
  <meta name="description" content={`Resultados de ${name} en ${raceName}`} />
  <meta property="og:title" content={`${name} — ${raceName}`} />
  <meta property="og:description" content={`Ver tiempo oficial y certificado de participación`} />
  {fixedImageUrl && <meta property="og:image" content={fixedImageUrl} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #0f0f0f; color: #fff; min-height: 100vh; }
    .header {
      background: #000; border-bottom: 2px solid #FF6B00;
      padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;
    }
    .logo { color: #FF6B00; font-size: 16px; font-weight: 900; letter-spacing: 2px; text-decoration: none; }
    .container { max-width: 700px; margin: 0 auto; padding: 20px 12px; }

    .card {
      background: #1a1a1a; border-radius: 24px; overflow: hidden;
      border: 1px solid #2d2d2d; margin-bottom: 20px;
    }
    .runner-photo {
      width: 90px; height: 90px; border-radius: 50%; object-fit: cover;
      border: 3px solid #FF6B00; margin-bottom: 16px;
      display: block; margin-left: auto; margin-right: auto;
    }
    .runner-placeholder {
      width: 90px; height: 90px; border-radius: 50%; background: #2a2a2a;
      border: 3px solid #333; display: flex; align-items: center;
      justify-content: center; font-size: 40px;
      margin: 0 auto 16px;
    }
    .runner-name { font-size: 22px; font-weight: 900; margin-bottom: 6px; }
    .race-name { color: #FF6B00; font-size: 15px; font-weight: 600; margin-bottom: 4px; }
    .race-date { color: #666; font-size: 13px; }
    .bib-badge {
      display: inline-block; background: #FF6B00; color: #fff;
      padding: 6px 18px; border-radius: 20px; font-weight: 900;
      font-size: 15px; margin-top: 12px;
    }

    .stats-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      padding: 4px;
    }
    .stat {
      padding: 16px 8px; text-align: center;
      border-right: 1px solid #2d2d2d;
    }
    .stat:last-child { border-right: none; }
    .stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #666; margin-bottom: 6px; }
    .stat-value { font-size: 20px; font-weight: 900; color: #fff; }
    .stat-value.orange { color: #FF6B00; }
    .stat-sub { font-size: 10px; color: #555; margin-top: 4px; }

    .actions { padding: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 12px 16px; border-radius: 12px; font-weight: 700;
      font-size: 13px; cursor: pointer; text-decoration: none;
      border: none; transition: all 0.2s;
    }
    .btn-primary { background: #FF6B00; color: #fff; flex: 1; justify-content: center; }
    .btn-primary:hover { background: #E55A00; transform: translateY(-1px); }
    .btn-secondary {
      background: transparent; color: #FF6B00;
      border: 2px solid #FF6B00; flex: 1; justify-content: center;
    }
    .btn-secondary:hover { background: rgba(255,107,0,0.1); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .pending-banner {
      background: #1a1000; border: 1px solid #FF6B00; border-radius: 12px;
      padding: 16px; text-align: center; color: #FF8533; margin-bottom: 16px;
      font-size: 14px;
    }
    #email-status { font-size: 12px; color: #888; text-align: center; padding: 8px; }
    .error { color: #f44; text-align: center; padding: 40px; }

    @media (min-width: 640px) {
      .header { padding: 16px 32px; }
      .logo { font-size: 18px; }
      .container { padding: 40px 24px; }
      .hero { padding: 40px; }
      .runner-photo { width: 120px; height: 120px; border-width: 4px; margin-bottom: 20px; }
      .runner-placeholder { width: 120px; height: 120px; border-width: 4px; font-size: 50px; margin-bottom: 20px; }
      .runner-name { font-size: 28px; }
      .stats-grid { padding: 8px; }
      .stat { padding: 24px 16px; }
      .stat-label { font-size: 11px; }
      .stat-value { font-size: 28px; }
      .actions { padding: 24px; gap: 12px; }
      .btn { padding: 14px 28px; font-size: 15px; }
      .pending-banner { padding: 20px; font-size: inherit; }
    }
  </style>
</head>
<body>
  <header class="header">
    <a href="/" class="logo">STRYD PANAMA</a>
    <a href="/podio" style="color:#FF6B00;font-size:14px;font-weight:600;text-decoration:none;">🏆 Ver Podio</a>
  </header>

  <div class="container">
    {error ? (
      <div class="error">
        <div style="font-size:40px;margin-bottom:16px;">⚠️</div>
        <p>No se pudo cargar la información del corredor.</p>
        <p style="font-size:13px;color:#555;margin-top:8px;">{error}</p>
      </div>
    ) : participant && (
      <>
        {!hasResult && (
          <div class="pending-banner">
            ⏱️ Aún no has cruzado la meta. ¡Mucho ánimo!<br />
            <small>Esta página se actualizará con tu tiempo oficial cuando termines.</small>
          </div>
        )}

        <div class="card">
          <div class="hero">
            {fixedImageUrl
              ? <img src={fixedImageUrl} alt={name} class="runner-photo" />
              : <div class="runner-placeholder">🏃</div>
            }
            <div class="runner-name">{name}</div>
            <div class="race-name">{raceName}</div>
            {raceDate && <div class="race-date">{raceDate}</div>}
            {categoryName && <div style="color:#888;font-size:13px;margin-top:4px;">Categoría: {categoryName}</div>}
            {age !== null && <div style="color:#888;font-size:13px;margin-top:4px;">Edad: {age} años</div>}
            {teamName && <div style="color:#FF6B00;font-size:13px;margin-top:4px;">👥 Equipo: {teamName}</div>}
            {distanceName && <div style="color:#888;font-size:13px;margin-top:4px;">Distancia: {distanceName}</div>}
            <div class="bib-badge">#{bibNumber}</div>
          </div>

          {hasResult && (
            <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));">
              <div class="stat">
                <div class="stat-label">Tiempo Oficial</div>
                <div class="stat-value orange" style="font-size:22px;">{formatTime(finishTime)}</div>
              </div>
              {positionGeneral !== null && (
                <div class="stat">
                  <div class="stat-label">Pos. General</div>
                  <div class="stat-value orange">#{positionGeneral}</div>
                  {totalInDistance > 0 && <div class="stat-sub">de {totalInDistance}</div>}
                </div>
              )}
              {positionGender !== null && (
                <div class="stat">
                  <div class="stat-label">Pos. Rama</div>
                  <div class="stat-value">#{positionGender}</div>
                </div>
              )}
              {positionCategory !== null && (
                <div class="stat">
                  <div class="stat-label">Pos. Categoría</div>
                  <div class="stat-value">#{positionCategory}</div>
                </div>
              )}
            </div>
          )}
        </div>

        <div class="card">
          <div class="actions">
            <button class="btn btn-primary" id="cert-btn" onclick="generateCertificate('pdf')">
              📄 Certificado PDF
            </button>
            <button class="btn btn-secondary" id="jpg-btn" onclick="generateCertificate('jpg')">
              🖼️ Certificado JPG
            </button>
            <button class="btn btn-secondary" id="email-btn" onclick="sendByEmail()">
              📧 Enviar al Email
            </button>
          </div>
          <div id="email-status"></div>
        </div>
      </>
    )}
  </div>

  <script define:vars={{
    participantId,
    name,
    raceName,
    finishTimeFormatted: finishTime ? formatTime(finishTime) : "",
    bibNumber,
    fixedImageUrl,
    positionGeneral,
    positionGender,
    positionCategory,
    certLogoUrl,
    categoryName,
    distanceName,
    teamName
  }}>
    const PARTICIPANT_ID = participantId;
    const PARTICIPANT_NAME = name;
    const RACE_NAME = raceName;
    const FINISH_TIME = finishTimeFormatted;
    const BIB = bibNumber;
    const PHOTO_URL = fixedImageUrl;
    const POSITION_GENERAL = positionGeneral;
    const POSITION_GENDER = positionGender;
    const POSITION_CATEGORY = positionCategory;
    const DISTANCE_NAME = distanceName;
    const CATEGORY_NAME = categoryName;
    const TEAM_NAME = teamName;
    const CERT_LOGO_URL = certLogoUrl;

    async function generateCertificate(format) {
      const btn = document.getElementById(format === 'jpg' ? 'jpg-btn' : 'cert-btn');
      btn.disabled = true;
      btn.textContent = 'Generando...';
      
      try {
        // Cargar jsPDF dinámicamente
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        document.head.appendChild(script);
        await new Promise(resolve => script.onload = resolve);

        const { jsPDF } = window.jspdf;

        if (format === 'pdf') {
          const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'letter' });

          // Fondo blanco
          doc.setFillColor(255, 255, 255);
          doc.rect(0, 0, 280, 216, 'F');

          // Línea decorativa gris arriba (como el ejemplo)
          doc.setDrawColor(220, 220, 220);
          doc.setLineWidth(1);
          doc.line(20, 15, 260, 15);

          // Cabecera: Certificado de Participación
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(26);
          doc.setTextColor(50, 50, 50);
          doc.text('Certificado de Participación', 140, 28, { align: 'center' });

          // Subtítulo: Nombre de la carrera
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(20);
          doc.setTextColor(0, 0, 0);
          doc.text(RACE_NAME, 140, 38, { align: 'center' });

          // Línea divisoria principal
          doc.setDrawColor(200, 200, 200);
          doc.setLineWidth(0.5);
          doc.line(20, 48, 260, 48);

          // Body Details
          const startY = 65;
          const lineGap = 11;
          let currentY = startY;

          const drawDetail = (label, value) => {
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(13);
            doc.setTextColor(50, 50, 50);
            const fullLabel = label + ': ';
            doc.text(fullLabel, 25, currentY);
            
            const labelWidth = doc.getTextWidth(fullLabel);
            doc.setFont('helvetica', 'normal');
            doc.setTextColor(0, 0, 0);
            doc.text(String(value || '—'), 25 + labelWidth, currentY);
            currentY += lineGap;
          };

          drawDetail('Nombre Participante', PARTICIPANT_NAME);
          drawDetail('Número', BIB);
          drawDetail('Distancia', DISTANCE_NAME);
          drawDetail('Categoría', CATEGORY_NAME);
          drawDetail('Tiempo Oficial', FINISH_TIME || '—');
          drawDetail('Posición General', POSITION_GENERAL || '—');
          drawDetail('Posición Rama', POSITION_GENDER || '—');
          drawDetail('Posición Categoría', POSITION_CATEGORY || '—');

          // Logo a la derecha
          if (CERT_LOGO_URL) {
            try {
              const logoRes = await fetch(CERT_LOGO_URL);
              const logoBlob = await logoRes.blob();
              const logoBase64 = await new Promise(resolve => {
                const r = new FileReader(); r.onload = e => resolve(e.target.result); r.readAsDataURL(logoBlob);
              });
              doc.addImage(logoBase64, 'PNG', 160, 60, 85, 85, '', 'FAST');
            } catch(e) {
              console.error('Error al cargar logo en PDF:', e);
            }
          }

          doc.save(`certificado-${PARTICIPANT_NAME.replace(/\s+/g,'-')}.pdf`);
        } else {
          // Generar directamente vía Canvas para obtener un JPG real de alta calidad
          const canvas = document.createElement('canvas');
          canvas.width = 1120;
          canvas.height = 864;
          const ctx = canvas.getContext('2d');

          // Función para cargar imágenes con CORS
          const loadImg = (src) => new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => resolve(null);
            img.src = src;
          });

          // Fondo blanco
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, 1120, 864);

          // Línea decorativa gris arriba
          ctx.strokeStyle = '#dcdcdc';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(80, 60);
          ctx.lineTo(1040, 60);
          ctx.stroke();

          // Cabecera: Certificado de Participación
          ctx.fillStyle = '#323232';
          ctx.font = 'normal 48px helvetica';
          ctx.textAlign = 'center';
          ctx.fillText('Certificado de Participación', 560, 112);

          // Subtítulo: Nombre de la carrera
          ctx.fillStyle = '#000000';
          ctx.font = 'bold 40px helvetica';
          ctx.fillText(RACE_NAME, 560, 152);

          // Línea divisoria principal
          ctx.strokeStyle = '#c8c8c8';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(80, 192);
          ctx.lineTo(1040, 192);
          ctx.stroke();

          // Body Details
          let currentYPx = 260;
          const lineGapPx = 44;

          const drawDetailPx = (label, value) => {
            ctx.textAlign = 'left';
            ctx.fillStyle = '#323232';
            ctx.font = 'bold 26px helvetica';
            const fullLabel = label + ': ';
            ctx.fillText(fullLabel, 100, currentYPx);
            
            const labelWidth = ctx.measureText(fullLabel).width;
            ctx.fillStyle = '#000000';
            ctx.font = 'normal 26px helvetica';
            ctx.fillText(String(value || '—'), 100 + labelWidth, currentYPx);
            currentYPx += lineGapPx;
          };

          drawDetailPx('Nombre Participante', PARTICIPANT_NAME);
          drawDetailPx('Número', BIB);
          drawDetailPx('Distancia', DISTANCE_NAME);
          drawDetailPx('Categoría', CATEGORY_NAME);
          drawDetailPx('Tiempo Oficial', FINISH_TIME || '—');
          drawDetailPx('Posición General', POSITION_GENERAL || '—');
          drawDetailPx('Posición Rama', POSITION_GENDER || '—');
          drawDetailPx('Posición Categoría', POSITION_CATEGORY || '—');

          // Logo a la derecha si existe
          if (CERT_LOGO_URL) {
            const logoImg = await loadImg(CERT_LOGO_URL);
            if (logoImg) {
              ctx.drawImage(logoImg, 640, 240, 340, 340);
            }
          }

          // Descarga directa del JPG
          const link = document.createElement('a');
          link.download = `certificado-${PARTICIPANT_NAME.replace(/\s+/g,'-')}.jpg`;
          link.href = canvas.toDataURL('image/jpeg', 0.95);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }
      } catch(e) {
        alert('Error generando certificado. Intenta de nuevo.');
        console.error(e);
      }
      btn.disabled = false;
      btn.textContent = format === 'jpg' ? '🖼️ Certificado JPG' : '📄 Certificado PDF';
    }

    async function sendByEmail() {
      const btn = document.getElementById('email-btn');
      const status = document.getElementById('email-status');
      btn.disabled = true;
      btn.textContent = 'Enviando...';
      status.textContent = '';
      try {
        const res = await fetch('/api/send-results', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ participantId: PARTICIPANT_ID })
        });
        const data = await res.json();
        if (data.success) {
          status.textContent = '✅ Email enviado exitosamente a tu correo registrado.';
          status.style.color = '#4caf50';
        } else {
          throw new Error(data.error || 'Error desconocido');
        }
      } catch (e) {
        status.textContent = `❌ Error: ${e.message}`;
        status.style.color = '#f44336';
      }
      btn.disabled = false;
      btn.textContent = '📧 Enviar al Email';
    }

    // Expose functions globally for HTML onclick attributes
    window.generateCertificate = generateCertificate;
    window.sendByEmail = sendByEmail;
  </script>
</body>
</html>
